{
  "name": "armadura-struct",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "CAD de armaduras com quantitativos vinculados — OpenStruct",
  "author": "Ricardo Corsini · OpenStruct",
  "repository": {
    "type": "git",
    "url": "https://github.com/ricardocorsini/armadura-struct.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "postinstall": "node scripts/prepare-wasm.mjs",
    "test": "vitest run",
    "check": "tsc -b && vitest run && node --test scripts/distribution/request-release.test.mjs",
    "test:e2e": "playwright test",
    "perf:cad": "node scripts/cad-benchmark.mjs",
    "example:rebar": "node scripts/examples/rebar-api.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "format": "prettier --write src tests scripts docs *.json *.ts *.md .github",
    "format:check": "prettier --check src tests scripts docs *.json *.ts *.md .github",
    "release:version": "node scripts/openstruct-version.mjs",
    "example:fabrication": "node scripts/examples/fabrication.mjs",
    "example:quantities": "node scripts/examples/armature-quantities.mjs",
    "example:clone": "node scripts/examples/armature-clone.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@mlightcad/libredwg-web": "0.8.4",
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "clipper-lib": "6.4.2",
    "dxf-parser": "1.1.2",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "^2.12.4",
    "@types/clipper-lib": "6.4.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
